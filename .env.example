# Optional: the scaffold runs without an environment file or service credentials.
APP_ENV=development
APP_URL=http://localhost:3000

# Add service configuration when each integration is implemented.
# Never put secrets in NEXT_PUBLIC_* variables.

# Optional MongoDB settings; required only for database operations.
# Put the Atlas development URI in .env.local, never in this tracked file.
# MONGODB_URI=mongodb+srv://<database-user>:<encoded-password>@<cluster-host>/
# MONGODB_DATABASE=<development-database-name>

# Staff authentication (generate a unique secret locally; never commit it).
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=<random-secret-at-least-32-characters>
